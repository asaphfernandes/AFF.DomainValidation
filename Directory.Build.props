<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <Version>2.0.0</Version>
    <Authors>Asaph Fernandes</Authors>
    <Description>Domain validation with fluent rules and DataAnnotations for .NET and .NET Framework.</Description>
    <Copyright>Copyright © Asaph Fernandes 2018-2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/asaphfernandes/AFF.DomainValidation</PackageProjectUrl>
    <RepositoryUrl>https://github.com/asaphfernandes/AFF.DomainValidation</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Domain;Validation;Fluent;DataAnnotations;AspNetCore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.0.0: .NET 9/10 and Framework 4.8/4.8.1, complete fluent chains, additional value validators, ASP.NET model validation and safe CPF validation. See README for migration notes.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
